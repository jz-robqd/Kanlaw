<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Group rules on the same model are OR-ed: internal users see everything
         except counterparties; Settings admins (also internal users) see all. -->
    <record id="rule_partner_hide_counterparty" model="ir.rule">
        <field name="name">Kanaan: counterparties hidden from non-admins</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('kanaan_is_counterparty', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_partner_admin_all" model="ir.rule">
        <field name="name">Kanaan: admins see counterparties</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
